# Copy to supabase/.env (ignored by git) and fill in values from your
# local-development Google Cloud OAuth client (type: Web application).
# Used by config.toml -> [auth.external.google]. Restart the local stack
# (npx supabase stop && npx supabase start) after changing these values.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret
